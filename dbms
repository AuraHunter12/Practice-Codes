CREATE DATABASE dbms_practical;
USE dbms_practical;

CREATE TABLE Dept (
    deptId INT PRIMARY KEY,
    deptName VARCHAR(10)
);

CREATE TABLE Emp (
    empId INT PRIMARY KEY,
    empName VARCHAR(10),
    empSal INT,
    empDeptId INT,
    FOREIGN KEY (empDeptId) REFERENCES Dept(deptId)
);

